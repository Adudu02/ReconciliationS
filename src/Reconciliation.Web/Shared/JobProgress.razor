@inherits LocalizedComponentBase

<div aria-live="polite">
    <PageStatus Model="Model" />
    @if (Model.Current is { } job)
    {
        <p>@T["job.label"] <span class="identifier">@job.Id</span> · <strong data-state="@job.State">@L.JobState(job.State)</strong> · @T.Format("job.attempt", job.Attempts, job.MaxAttempts)</p>
        <label for="progress-@job.Id">@T.Format("job.progress", job.ProgressDone, job.ProgressTotal)</label>
        <progress id="progress-@job.Id" max="@Math.Max(1, job.ProgressTotal)" value="@job.ProgressDone">@job.ProgressDone / @job.ProgressTotal</progress>
    }
</div>

@code {
    [Parameter, EditorRequired] public JobProgressViewModel Model { get; set; } = default!;
    protected override void OnInitialized() => Model.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    protected override void Dispose(bool disposing)
    {
        if (disposing) Model.Changed -= Refresh;
        base.Dispose(disposing);
    }
}
