@page "/ui/imports"
@inherits LocalizedComponentBase
@inject ImportViewModel Model
@inject SessionState Session

<section>
    <p class="eyebrow">@T["imports.eyebrow"]</p><h1>@T["nav.imports"]</h1>
    @if (!Session.CanWrite) { <p>@T["imports.read-only"]</p> }
    else
    {
        <p>@T["imports.intro"]</p>
        <p class="muted">@T["imports.limits"]</p>
        <form class="panel" @onsubmit="UploadAsync" @onsubmit:preventDefault>
            <label for="kind">@T["imports.kind"]</label><select id="kind" @bind="Model.Kind" disabled="@Model.Busy"><option value="cfdi">@T["imports.kind.cfdi"]</option><option value="bank-statement">@T["imports.kind.bank-statement"]</option></select>
            @if (Model.Kind == "bank-statement")
            {
                <label for="bank">@T["imports.bank"]</label><select id="bank" @bind="Model.Bank" disabled="@Model.Busy">@foreach (var bank in Model.Banks) { <option value="@bank">@bank</option> }</select>
                <label for="account">@T["imports.account"]</label><input id="account" required maxlength="200" @bind="Model.AccountReference" disabled="@Model.Busy" />
            }
            <label for="files">@T["imports.files"]</label><InputFile id="files" OnChange="SelectAsync" multiple="@(Model.Kind == "cfdi")" accept="@(Model.Kind == "cfdi" ? ".xml" : ".csv")" disabled="@Model.Busy" />
            <p class="muted">@T.Format("import.files-selected", Model.Files.Length)</p><button type="submit" disabled="@(Model.Busy || Model.Files.Length == 0)">@T["imports.upload"]</button>
        </form>
        <PageStatus Model="Model" /><JobProgress Model="Model.Jobs" />
        @if (Model.Report is { } report)
        {
            <section class="panel table-wrap"><h2>@T["imports.report"]</h2><table><caption>@T.Format("imports.upload-caption", report.UploadId)</caption><thead><tr><th scope="col">@T["col.file"]</th><th scope="col">@T["col.status"]</th><th scope="col">@T["col.details"]</th><th scope="col">@T["col.movements"]</th></tr></thead><tbody>@foreach (var file in report.Files) { <tr><th scope="row">@file.Name</th><td>@L.ImportStatus(file.Status)</td><td>@if (file.Reason is not null) { <span lang="@ServerLang">@file.Reason</span> }</td><td>@T.Format("imports.counts", file.ImportedMovements, file.DuplicateMovements)</td></tr> }</tbody></table><p><a href="/ui/overview">@T["imports.open-overview"]</a></p></section>
        }
    }
</section>

@code {
    private readonly CancellationTokenSource lifetime = new();
    protected override Task OnInitializedAsync() => Session.CanWrite ? Model.LoadBanksAsync() : Task.CompletedTask;
    private Task SelectAsync(InputFileChangeEventArgs args) => Model.SelectFilesAsync(args.GetMultipleFiles(args.FileCount));
    private Task UploadAsync() => Model.UploadAsync(Model.Files, lifetime.Token);
    protected override void Dispose(bool disposing)
    {
        if (disposing) { lifetime.Cancel(); lifetime.Dispose(); Model.Jobs.Dispose(); }
        base.Dispose(disposing);
    }
}
