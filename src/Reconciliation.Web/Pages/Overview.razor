@page "/"
@page "/ui/overview"
@inject WorkspaceViewModel Model

<section>
    <p class="eyebrow">WORKSPACE</p>
    <h1>Company overview</h1>
    <p>Imported invoices and bank movements, grouped by their current state.</p>
    <PageStatus Model="Model" />
    @if (Model.Overview is { } value)
    {
        <p class="notice">@value.Disclaimer</p>
        <div class="resource-grid">
            @foreach (var resource in new[] { ("Invoices", value.Invoices), ("Movements", value.Movements) })
            {
                <section class="panel">
                    <h2>@resource.Item1</h2>
                    <p class="metric">@Display.Money(resource.Item2.Amount)<span>@resource.Item2.Count imported</span></p>
                    <table><caption>@resource.Item1 by state</caption><thead><tr><th scope="col">State</th><th scope="col">Count</th><th scope="col">Amount</th></tr></thead><tbody>
                        @foreach (var state in resource.Item2.States) { <tr><th scope="row"><span class="badge @state.State">@state.State</span></th><td>@state.Count</td><td class="money">@Display.Money(state.Amount)</td></tr> }
                    </tbody><tfoot><tr><th scope="row">Total</th><td>@resource.Item2.Count</td><td class="money">@Display.Money(resource.Item2.Amount)</td></tr></tfoot></table>
                </section>
            }
        </div>
        <section class="panel alerts"><h2>Invoice alerts</h2><dl>
            <div><dt>Complement overdue</dt><dd data-alert="complement">@value.Alerts.ComplementOverdue</dd></div>
            <div><dt>Cancellation in process</dt><dd>@value.Alerts.CancellationInProcess</dd></div>
            <div><dt>EFOS warning</dt><dd data-alert="efos">@value.Alerts.EfosWarning</dd></div>
            <div><dt>Global invoice</dt><dd>@value.Alerts.Global</dd></div>
        </dl></section>
        <p class="muted">@value.TotalsNote</p>
    }
</section>

@code { protected override Task OnInitializedAsync() => Model.LoadOverviewAsync(); }
