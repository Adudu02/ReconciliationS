@inject WorkspaceViewModel Model
@inject SessionState Session
@inject NavigationManager Navigation

<section>
    <p class="eyebrow">WORKSPACE</p>
    <h1>Choose a company</h1>
    <p>Your membership controls the actions available in each company.</p>
    <PageStatus Model="Model" />
    <ul class="companies">
        @foreach (var company in Model.Companies)
        {
            <li><button data-company="@company.Id" @onclick="() => Select(company)"><strong>@company.Name</strong><span>@company.Rfc · @company.Role</span>@if (company.ArchivedAt is not null) { <span>Archived · read-only</span> }</button></li>
        }
    </ul>
    @if (!Model.Busy && Model.Error is null && Model.Companies.Length == 0) { <p>No company memberships are available. Ask a company administrator for access.</p> }
</section>

@code {
    protected override Task OnInitializedAsync() => Model.LoadCompaniesAsync();
    private void Select(CompanyItem company) { Session.SelectCompany(company); Navigation.NavigateTo("/ui/overview"); }
}
