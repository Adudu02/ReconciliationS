@inherits LocalizedComponentBase
@inject WorkspaceViewModel Model
@inject SessionState Session
@inject NavigationManager Navigation

<section>
    <p class="eyebrow">@T["picker.eyebrow"]</p>
    <h1>@T["picker.title"]</h1>
    <p>@T["picker.intro"]</p>
    <PageStatus Model="Model" />
    <ul class="companies">
        @foreach (var company in Model.Companies)
        {
            <li><button data-company="@company.Id" @onclick="() => Select(company)"><strong>@company.Name</strong><span>@company.Rfc · @L.Role(company.Role)</span>@if (company.ArchivedAt is not null) { <span>@T["company.archived-read-only"]</span> }</button></li>
        }
    </ul>
    @if (!Model.Busy && Model.Error is null && Model.Companies.Length == 0) { <p>@T["picker.empty"]</p> }
</section>

@code {
    protected override Task OnInitializedAsync() => Model.LoadCompaniesAsync();
    private void Select(CompanyItem company) { Session.SelectCompany(company); Navigation.NavigateTo("/ui/overview"); }
}
