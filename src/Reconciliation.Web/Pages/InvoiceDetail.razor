@page "/ui/invoices/{InvoiceId:guid}"
@inject InvoiceViewModel Model

<section>
    <a href="/ui/invoices">← Invoices</a><h1>Invoice summary</h1>
    <PageStatus Model="Model" />
    @if (Model.Summary is { } value)
    {
        <p class="identifier">@value.Uuid</p><p><span class="badge @value.State">@value.State</span> · @value.Direction · @(value.PaymentMethod ?? "Payment method unavailable")</p>
        <div class="resource-grid">
            <section class="panel"><h2>Amounts</h2><dl class="summary-values"><div><dt>Invoice total</dt><dd>@Display.Money(value.Total)</dd></div><div><dt>Credit notes applied</dt><dd>@Display.Money(value.CreditNotes)</dd></div><div><dt>Net payable</dt><dd>@Display.Money(value.NetPayable)</dd></div><div><dt>Confirmed paid</dt><dd>@Display.Money(value.Paid)</dd></div><div><dt>Paid percentage</dt><dd>@value.PaidPercentage.ToString("0.##")%</dd></div><div><dt>Pending</dt><dd data-summary="pending">@Display.Money(value.Pending)</dd></div><div><dt>Uncovered by links</dt><dd>@Display.Money(value.Uncovered)</dd></div></dl></section>
            <section class="panel"><h2>Status and reasons</h2><p>SAT: @value.SatStatus</p><p>Cancellation: @(value.CancellationStatus ?? "No cancellation information")</p><p>EFOS warning: @(value.EfosWarning ? "Flagged" : "No warning")</p><ul>@foreach (var reason in value.Reasons) { <li class="@(reason.RequiresReview ? "reason" : "muted")">@reason.Code @(reason.RequiresReview ? "· requires review" : "· information")</li> }</ul></section>
        </div>
        <section class="panel table-wrap"><h2>Linked movements</h2><table><caption>Suggested links do not count toward confirmed paid amounts.</caption><thead><tr><th scope="col">Movement</th><th scope="col">State / confidence</th><th scope="col">Applied</th><th scope="col">Payment complement</th></tr></thead><tbody>
            @foreach (var link in value.Links)
            {
                <tr><th scope="row">@link.Date.ToString("yyyy-MM-dd")<p>@link.Description</p><small>Movement @link.MovementId · @Display.Money(link.Amount)</small></th><td><span class="badge @link.State">@link.State</span><p>@link.Confidence</p></td><td class="money">@Display.Money(link.AmountApplied)</td><td><span class="badge @link.ComplementStatus">@link.ComplementStatus</span>@if (link.DueDate is { } due) { <p>Due @due.ToString("yyyy-MM-dd")</p> }@if (link.PaymentCfdiId is { } payment) { <p class="identifier">Payment CFDI @payment</p> }@if (link.PaymentForm is not null) { <p>Payment form @link.PaymentForm · @link.PaymentDate?.ToString("yyyy-MM-dd")</p> }@if (link.CashPaymentWarning is not null) { <p role="note" class="notice">@link.CashPaymentWarning</p> }</td></tr>
            }
        </tbody></table></section>
    }
</section>

@code {
    [Parameter] public Guid InvoiceId { get; set; }
    protected override Task OnParametersSetAsync() => Model.LoadSummaryAsync(InvoiceId);
}
