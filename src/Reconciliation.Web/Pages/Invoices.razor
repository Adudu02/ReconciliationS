@page "/ui/invoices"
@inherits LocalizedComponentBase
@inject InvoiceViewModel Model

<section>
    <p class="eyebrow">@T["invoices.eyebrow"]</p><h1>@T["nav.invoices"]</h1>
    <form class="filters" @onsubmit="Model.LoadAsync" @onsubmit:preventDefault>
        <div><label for="state">@T["col.state"]</label><select id="state" @bind="Model.State" disabled="@Model.Busy"><option value="">@T["invoices.all-states"]</option><option value="pending">@T["state.pending"]</option><option value="suggested">@T["state.suggested"]</option><option value="reconciled">@T["state.reconciled"]</option></select></div>
        <div><label for="complement">@T["invoices.complement-status"]</label><select id="complement" @bind="Model.ComplementStatus" disabled="@Model.Busy"><option value="">@T["invoices.all-complements"]</option><option value="missing">@T["invoices.complement-missing"]</option><option value="overdue">@L.ComplementStatus("overdue")</option></select></div>
        <button type="submit" disabled="@Model.Busy">@T["invoices.apply"]</button>
    </form>
    <PageStatus Model="Model" />
    <div class="panel table-wrap" tabindex="0" role="region" aria-label="@T["invoices.region"]"><table><caption>@T["invoices.caption"]</caption><thead><tr><th scope="col">@T["col.invoice"]</th><th scope="col">@T["col.issued"]</th><th scope="col">@T["col.direction"]</th><th scope="col">@T["col.state"]</th><th scope="col" class="money">@T["col.total"]</th><th scope="col" class="money">@T["col.pending"]</th><th scope="col">@T["col.complement-due"]</th></tr></thead><tbody>
        @foreach (var invoice in Model.Invoices)
        {
            <tr><th scope="row"><a href="/ui/invoices/@invoice.Id">@invoice.Uuid</a></th><td>@invoice.IssuedAt.ToString("yyyy-MM-dd")</td><td>@L.Direction(invoice.Direction)</td><td><span class="badge @invoice.State">@L.State(invoice.State ?? "")</span></td><td class="money">@Display.Money(invoice.Total)</td><td class="money">@(invoice.PendingAmount is { } pending ? Display.Money(pending) : "—")</td><td>@(invoice.DueDate?.ToString("yyyy-MM-dd") ?? "—") @if (invoice.ComplementOverdue == true) { <span class="badge overdue">@L.ComplementStatus("overdue")</span> }</td></tr>
        }
    </tbody></table></div>
    @if (!Model.Busy && Model.Error is null && Model.Invoices.Length == 0) { <p>@T["invoices.empty"]</p> }
    @if (Model.HasMore) { <button class="secondary" disabled="@Model.Busy" @onclick="Model.NextAsync">@T["invoices.load-more"]</button> }
</section>

@code { protected override Task OnInitializedAsync() => Model.LoadAsync(); }
