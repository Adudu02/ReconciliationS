@inherits LocalizedComponentBase
@inject SessionState Session
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IDocumentLanguage Document

<a class="skip" href="#main">@T["topbar.skip"]</a>
<header class="topbar"><a class="brand" href="/ui/overview">CFDI <span>reconciliation</span></a><span class="demo">@T["topbar.demo"]</span><LanguageSwitch />
    @if (Session.IsAuthenticated)
    {
        @if (Session.Company is { } company) { <div class="identity"><strong>@company.Name</strong><span>@L.Role(company.Role) @(company.ArchivedAt is null ? "" : "· " + T["company.archived-read-only"])</span></div><button class="secondary switch-company" @onclick="Session.SwitchCompany">@T["topbar.switch-company"]</button> }
        <button class="secondary sign-out" @onclick="LogoutAsync">@T["topbar.sign-out"]</button>
    }
</header>
@if (ShellError is not null) { <p role="alert" class="error">@ShellError</p> }
<div class="workspace">
    @if (Session.IsAuthenticated && Session.Company is not null)
    {
        <nav aria-label="@T["nav.label"]" class="sidebar"><p class="eyebrow">@T["nav.eyebrow"]</p><NavLink href="/ui/overview">@T["nav.overview"]</NavLink><NavLink href="/ui/review">@T["nav.review"]</NavLink><NavLink href="/ui/invoices">@T["nav.invoices"]</NavLink><NavLink href="/ui/movements">@T["nav.movements"]</NavLink>@if (Session.CanWrite) { <NavLink href="/ui/imports">@T["nav.imports"]</NavLink> }</nav>
    }
    <main id="main" @key="Session.Company?.Id">
        @if (Loading) { <p role="status">@T["shell.restoring"]</p> }
        else if (!Session.IsAuthenticated) { <Login /> }
        else if (Session.Company is null) { <CompanyPicker /> }
        else
        {
            <Router AppAssembly="typeof(App).Assembly"><Found Context="route"><RouteView RouteData="route" /><FocusOnNavigate RouteData="route" Selector="h1" /></Found><NotFound><h1>@T["shell.not-found.title"]</h1><p><a href="/ui/overview">@T["shell.not-found.back"]</a></p></NotFound></Router>
        }
    </main>
</div>
<footer>@T["notice.disclaimer"]</footer>

@code {
    private bool Loading { get; set; } = true;
    private string? ShellError { get; set; }
    protected override async Task OnInitializedAsync()
    {
        T.Set(InitialLanguage(Navigation.Uri));
        await Document.SetAsync(T.Language);
        Session.Changed += Refresh;
        try { await Api.RestoreAsync(); }
        catch (HttpRequestException) { ShellError = T["shell.service-unavailable"]; }
        finally { Loading = false; }
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private async Task LogoutAsync()
    {
        try { await Api.LogoutAsync(); }
        catch (ApiProblemException problem) { ShellError = problem.Message; }
        catch (HttpRequestException) { ShellError = T["shell.sign-out-unreachable"]; }
    }
    // The language is chosen once from ?lang= (never stored: ADR-010 keeps browser storage empty); anything unrecognised is Spanish.
    private static string InitialLanguage(string uri)
    {
        foreach (var pair in new Uri(uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (Uri.UnescapeDataString(parts[0]) == "lang" && parts.Length == 2 && Uri.UnescapeDataString(parts[1]) is "en") return "en";
        }
        return "es";
    }
    protected override void Dispose(bool disposing)
    {
        if (disposing) Session.Changed -= Refresh;
        base.Dispose(disposing);
    }
}
