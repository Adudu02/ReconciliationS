{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How a reconciliation run decides",
    "output": "matching-pipeline.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "data", "label": "Company data" },
    { "id": "engine", "label": "Pure matching engine" },
    { "id": "store", "label": "Persistence" }
  ],
  "mainPath": ["load", "stage1", "cleanup", "stage2", "persist", "audit"],
  "nodes": [
    { "id": "load", "lane": "data", "col": 0, "type": "database", "label": "Load", "sublabel": "set-based, one company" },
    { "id": "stage1", "lane": "engine", "col": 1, "type": "backend", "label": "Stage 1", "sublabel": "complement, exact", "tag": "reconciled" },
    { "id": "cleanup", "lane": "engine", "col": 2, "type": "backend", "label": "Cleanup", "sublabel": "free taken capacity" },
    { "id": "stage2", "lane": "engine", "col": 3, "type": "backend", "label": "Stage 2", "sublabel": "gate, points, rank", "tag": "suggested" },
    { "id": "persist", "lane": "store", "col": 4, "type": "database", "label": "Links", "sublabel": "batched, no duplicates" },
    { "id": "audit", "lane": "store", "col": 5, "type": "security", "label": "Audit", "sublabel": "same transaction" }
  ],
  "edges": [
    { "id": "e1", "from": "load", "to": "stage1", "label": "inputs", "role": "main" },
    { "id": "e2", "from": "stage1", "to": "cleanup", "role": "main" },
    { "id": "e3", "from": "cleanup", "to": "stage2", "role": "main" },
    { "id": "e4", "from": "stage2", "to": "persist", "label": "proposals", "role": "main" },
    { "id": "e5", "from": "persist", "to": "audit", "role": "main" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Stage 1", "items": ["A payment complement names the invoice, the amount is exact and the date is inside the tolerance", "Only this stage reconciles automatically"] },
    { "dot": "amber", "title": "Stage 2", "items": ["An amount match or a strong identifier is required; date alone never counts", "One amount criterion per candidate, one best suggestion per movement"] },
    { "dot": "violet", "title": "Safe reruns", "items": ["User decisions and rejected pairs are never overwritten", "A second run over the same data changes nothing"] }
  ]
}
