# Local development placeholders; replace before running outside Docker.
ConnectionStrings__Default=Host=localhost;Port=5432;Username=cfdi_app;Password=<app-database-password>;Database=cfdi;GSS Encryption Mode=Disable
APP_DB_PASSWORD=<app-database-password>
JWT_SIGNING_KEY=<replace-with-random-signing-key-at-least-32-bytes>
Jwt__SigningKey=<same-random-signing-key-for-dotnet-run>
# Optional: migrator up creates this operator once; it never resets an existing password.
OPERATOR_EMAIL=<operator-email>
OPERATOR_PASSWORD=<operator-password-at-least-12-characters>

# Optional ingestion defaults (positive limits; retention minimum 5 years).
Ingestion__MaxFileBytes=10485760
Ingestion__MaxUploadBytes=20971520
Ingestion__MaxFiles=20
Ingestion__MaxXmlNodes=100000
Ingestion__MaxXmlDepth=64
Ingestion__RetentionYears=10

Ingestion__MaxStatementLines=100000
Ingestion__MaxDescriptionLength=500

# Login fixed-window limits; tune and monitor per-email denial-of-service trade-offs.
LoginRateLimit__EmailPermitLimit=10
LoginRateLimit__IpPermitLimit=30
LoginRateLimit__WindowSeconds=60

# Session renewal; bounds: access 5-30 min, positive idle/absolute, nonnegative grace.
Session__AccessTokenMinutes=15
Session__IdleMinutes=480
Session__AbsoluteDays=30
Session__ReuseGraceSeconds=10
Session__RefreshCookie=false
# Opt-in browser transport; set true for the Web UI and set its exact browser Origin below.
Session__BrowserRefreshCookie=false
# Required allow-list for successful cookie renewal; use your HTTPS frontend Origin.
# Session__AllowedOrigins__0=https://app.example.invalid
RefreshRateLimit__IpPermitLimit=60

# Durable jobs; Compose maps these to Jobs__* configuration (no host SDK required).
JOBS_POLL_INTERVAL_MILLISECONDS=500
JOBS_CONCURRENCY=2
JOBS_LEASE_SECONDS=60
JOBS_MAX_ATTEMPTS=5
JOBS_BACKOFF_BASE_SECONDS=2
JOBS_BACKOFF_CAP_SECONDS=300

# SAT offline defaults; Compose maps these to Sat:* in API and worker.
# Real HTTPS consultation remains Phase 2 / task 7.6 pending live validation.
SAT_MODE=stub
SAT_ENDPOINT=
SAT_CURRENT_CACHE_TTL=1.00:00:00
SAT_NOT_FOUND_CACHE_TTL=01:00:00
SAT_REQUEST_TIMEOUT=00:00:10
SAT_JOB_BUDGET=00:01:00
SAT_MAX_ATTEMPTS=3
SAT_MAX_REQUESTS_PER_SECOND=2
SAT_MAX_FOLLOW_UP_GENERATIONS=20
SAT_RECORD_RESPONSES=false
# dotnet run: Sat__Mode, Sat__Endpoint, Sat__RecordingDirectory, etc.
# Default directory .local/sat-recordings is git-ignored; Compose persists it in sat-recordings.
